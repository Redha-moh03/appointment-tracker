<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit your appointment</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('./partials/navbar') %>

    <h1>Edit appointment</h1>

    <form action="/edit/<%= appointment._id %>?_method=PUT" method="post">
        <label for="date">date</label>
        <input required type="date" id="date" name="date" min="2026-11-04" max="2030-12-31">
        <label for="startTime">Choose a time</label>
        <input required name="startTime" id="startTime" min="07:00" max="21:00" step="1800" type="time" />
        <button>Update appointment</button>
    </form>
</body>

</html>