<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Book an appointment</title>
</head>

<body>
  <%- include('../partials/navbar') %>

  <h1> Book an appointment </h1>
  <% if(!chosenDepartment) {%>
  <form action="/book" method="get">
    <label for="department">Choose a department</label>
    <select name="department" id="department" required>
      <% for(let oneDepartment of department) {%>
      <option value="<%= oneDepartment._id %>"><%= oneDepartment.departmentName %></option>
      <% } %>
    </select>
    <button>Continue</button>
  </form>
  <% } else {%>
  <p>Department:<%= chosenDepartment.departmentName %> <a href="/book">Change</a></p>
  <form action="/book/new" method="post">
    <input type="hidden" name="department" value="<%= chosenDepartment._id %>">

    <label for="doctor">Doctor: </label>
    <select required name="doctor" id="doctor">
      <% doctor.forEach(doctor => { %>
      <option value="<%= doctor._id %>"><%= doctor.username %></option>
      <% }) %>
    </select>
    <label for="date">date</label>
    <input required type="date" id="date" name="date" min="2026-11-04" max="2030-12-31">
    <label for="startTime">Choose a time</label>
    <input required name="startTime" id="startTime" min="07:00" max="21:00" step="1800" type="time" />
    <button>Book an appointment</button>
  </form>
  <% } %>
</body>

</html>