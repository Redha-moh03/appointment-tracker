<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My appointment</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('./partials/navbar') %>

    <% if(user.role === 'doctor') {%>
    <h1>My schedule</h1>
    <% } else{%>
    <h1>My appointments</h1>
    <% } %>
    <% for (let oneAppointment of myAppointment) {%>
    <% if(user.role === 'doctor') {%>
    <p><%= oneAppointment.owner.username %></p>
    <a href="/details/<%= oneAppointment._id %>">See details</a>
    <% } else {%>
    <p><%= oneAppointment.doctorName.username %></p>
    <a href="/details/<%= oneAppointment._id %>">See details</a>
    <% } %>
    <% } %>
</body>

</html>